# For PCBs designed using KiCad: https://www.kicad.org/
# Format documentation: https://kicad.org/help/file-formats/

.idea/

# ==========================================
# KiCad 10 Recommended .gitignore
# ==========================================

# KiCad 10 Local Backups and Git History
.history/
*.bak
*-bak
*.bck

# Local Project Workspace State (Window positions, active layers)
*.kicad_prl

# Temporary and Lock Files
*.lck
*.tmp

# Auto-generated ERC and DRC Reports
*.erc
*.drc
*.rpt

# Standard Manufacturing Output Folders
# (Uncomment if you regenerate these locally and do not want them in Git)
# gbr/
# gerber/
# gerbers/
# specctra_dsn/

*~
\#*\#
/.emacs.desktop
/.emacs.desktop.lock
*.elc
auto-save-list
tramp
.\#*

# Org-mode
.org-id-locations
*_archive

# flymake-mode
*_flymake.*

# eshell files
/eshell/history
/eshell/lastdir

# elpa packages
/elpa/

# reftex files
*.rel

# AUCTeX auto folder
/auto/

# cask packages
.cask/
dist/

# Flycheck
flycheck_*.el

# server auth directory
/server/

# projectiles files
.projectile

*.diff
*.patch
*.orig
*.rej

*~
.#*
*#
.*.swp

*.flt
*.gmo
*.info
*.la
*.lo
*.o
*.pyc
*.tmp
*.a

.deps
.libs

autom4te.cache
config.cache
# GCC does not support in-tree builds, do not conceal a stray config.h:
# config.h
config.intl
config.log
config.status
libtool
POTFILES
*-POTFILES

TAGS
TAGS.sub
cscope.out

.local.vimrc
.lvimrc

.clang-format
.clang-tidy
.clangd
.cache
compile_commands.json

.gdbinit
.gdb_history

perf.data
perf.data.old

# ignore core files, but not java/net/protocol/core/
core
!core/

lost+found

# ignore ./con

*.elf
*.lst
*.hex
*.map
